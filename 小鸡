    def _source(self, row, index=0):
        if not isinstance(row, dict):
            return None
        code = _text(row.get('from')).strip()
        if not code:
            return None
        episodes = {}
        raw = row.get('episodes')
        for offset, episode in enumerate(raw if isinstance(raw, list) else []):
            if not isinstance(episode, dict):
                continue
            position = _int(episode.get('position'), offset+1)
            episodes[position] = {'position': position, 'title': _text(episode.get('title')).strip() or '第%d集' % position, 'url': _text(episode.get('url')).strip()}
        try:
            order = float(row.get('sort', index))
            if order != order or abs(order) == float('inf'):
                order = index
        except (ValueError, TypeError, OverflowError):
            order = index
        status = _text(row.get('decode_status')).strip()
        return {'from': code, 'display_name': _text(row.get('display_name')).strip() or code, 'sort': order, 'decode_status': status if status in ('1', '2') else '0', 'episode_count': max(len(episodes), _int(row.get('episode_count'), 0)), 'episodes': episodes}

    def _merge_catalog(self, state, patch):
        if not isinstance(patch, dict) or not isinstance(patch.get('sources'), list):
            raise _ApiError('播放目录数据结构错误')
        revision = _text(patch.get('revision'))
        old_revision = state.get('revision', '')
        complete = patch.get('complete') is True
        if old_revision and revision and old_revision != revision and not complete:
            raise _ApiError('播放目录版本已更新，请重新打开详情')
        old = state.get('sources', OrderedDict())
        merged = OrderedDict() if complete else OrderedDict(old)
        for index, row in enumerate(patch['sources']):
            source = self._source(row, index)
            if not source:
                continue
            code = source['from']
            previous = merged.get(code)
            if previous and not complete:
                episodes = dict(previous['episodes'])
                for pos, episode in source['episodes'].items():
                    if not episode['url'] and pos in episodes:
                        episode['url'] = episodes[pos]['url']
                    episodes[pos] = episode
                source['episodes'] = episodes
                source['episode_count'] = max(source['episode_count'], previous['episode_count'], len(episodes))
                for field in ('sort', 'display_name', 'decode_status'):
                    if field not in row:
                        source[field] = previous[field]
            merged[code] = source
        selected = patch.get('selected_source')
        if isinstance(selected, dict):
            code = _text(selected.get('from'))
            source = merged.get(code)
            if source:
                full = self._source(selected)
                if full:
                    for pos, episode in full['episodes'].items():
                        prior = source['episodes'].get(pos)
                        if prior and not episode['url']:
                            episode['url'] = prior['url']
                        source['episodes'][pos] = episode
        return {'revision': revision or old_revision, 'sources': merged, 'complete': complete}

    def _native_catalog(self, identity):
        data = self._request('vod/detail_v2', {'vod_id': identity}, ttl=40)
        if not isinstance(data, dict) or not isinstance(data.get('detail'), dict):
            raise _ApiError('详情数据结构错误')
        detail = data['detail']
        patch = data.get('playback')
        state = self._merge_catalog({}, patch)
        params = {'vod_id': identity, 'base_revision': state['revision']}
        try:
            playback = self._request('vod/playback_v2', params, ttl=20, timeout=20)
            state = self._merge_catalog(state, playback)
        except _ApiError as exc:
            if not state['sources']:
                raise
            self._failure(exc)
        return detail, state

    def _aggregate(self, identity='', detail=None):
        params = {}
        if identity:
            params['vod_id'] = identity
        elif isinstance(detail, dict):
            params = {'name': _text(detail.get('vod_name')), 'year': _text(detail.get('vod_year')), 'type': _text(detail.get('standard_category') or detail.get('vod_class')), 'douban_id': _text(detail.get('vod_douban_id'))}
        if not params or not any(params.values()):
            return []
        data = self._request('internal/search_aggregate', params, ttl=45, timeout=25)
        result = []
        for index, row in enumerate(data if isinstance(data, list) else []):
            if not isinstance(row, dict):
                continue
            play_froms = _text(row.get('vod_play_from')).split('$$$')
            groups = _text(row.get('vod_play_url')).split('$$$')
            for subindex, group in enumerate(groups):
                play_from = play_froms[subindex] if subindex < len(play_froms) else ''
                source_code = _text(row.get('site_key')).strip() or play_from.strip() or 'external_%d' % index
                name = _text(row.get('site_name')).strip() or play_from.strip() or source_code
                if len(groups) > 1:
                    name += '·' + (play_from or str(subindex+1))
                episodes = []
                for position, part in enumerate(group.split('#'), 1):
                    title, separator, value = part.partition('$')
                    if not separator:
                        continue
                    value = value.strip()
                    if value:
                        episodes.append({'position': position, 'title': title.strip() or '第%d集' % position, 'url': value})
                if not episodes:
                    continue
                source = self._source({'from': source_code, 'display_name': name, 'sort': row.get('sort', 1000+index), 'decode_status': row.get('decode_status'), 'episodes': episodes}, index)
                source['external'] = True
                source['external_params'] = params
                source['row'] = index
                source['subline'] = subindex
                result.append(source)
        return result

    def _playlists(self, sources, identity, revision):
        names, groups, used = [], [], {}
        for source in sorted(sources, key=lambda s: s['sort']):
            code = source['from']
            episodes = dict(source['episodes'])
            if not episodes and source['episode_count']:
                episodes = {p: {'position': p, 'title': '第%d集' % p, 'url': ''} for p in range(1, min(source['episode_count'], 10000)+1)}
            if not episodes:
                continue
            display = source['display_name'].replace('$', '＄').replace('#', '＃')
            used[display] = used.get(display, 0) + 1
            if used[display] > 1:
                display += ' (%d)' % used[display]
            entries = []
            for position in sorted(episodes):
                episode = episodes[position]
                token = {'v': identity, 'r': revision, 's': code, 'p': position, 'u': episode['url'], 'd': source['decode_status']}
                if source.get('external'):
                    token.update(x=source['external_params'], i=source['row'], n=source['subline'])
                title = episode['title'].replace('$', '＄').replace('#', '＃')
                entries.append(title + '$' + _pack('xjkp:', token))
            names.append(display)
            groups.append('#'.join(entries))
        return '$$$'.join(names), '$$$'.join(groups)

    def detailContent(self, ids):
        self._ready()
        identity = _text(ids[0] if isinstance(ids, (list, tuple)) and ids else ids).strip()
        try:
            if identity.startswith('xjkx:'):
                detail = _unpack('xjkx:', identity)
                sources = self._aggregate(detail=detail)
                revision = ''
            else:
                if not identity:
                    raise _ApiError('影片标识为空')
                detail, state = self._native_catalog(identity)
                revision = state['revision']
                sources = list(state['sources'].values())
                if self._include_external:
                    try:
                        sources.extend(self._aggregate(identity))
                    except _ApiError as exc:
                        self._failure(exc)
            item = self._item(detail, identity.startswith('xjkx:')) or {}
            item['vod_id'] = identity
            for key in ('vod_actor', 'vod_director', 'vod_class', 'vod_area', 'vod_year', 'type_name'):
                item[key] = _text(detail.get(key))
            item['vod_content'] = html.unescape(re.sub(r'<[^>]*>', '', _text(detail.get('vod_content'))))
            item['vod_play_from'], item['vod_play_url'] = self._playlists(sources, identity, revision)
            return {'list': [item]}
        except Exception as exc:
            return {'list': [], 'msg': self._failure(exc)}

    def _episode_url(self, token):
        value = _text(token.get('u')).strip()
        if value:
            return value, _text(token.get('d'))
        code, position = _text(token.get('s')), _int(token.get('p'))
        identity = _text(token.get('v'))
        external = token.get('x')
        if isinstance(external, dict):
            if external.get('vod_id'):
                sources = self._aggregate(_text(external['vod_id']))
            else:
                detail = {'vod_name': external.get('name'), 'vod_year': external.get('year'), 'standard_category': external.get('type'), 'vod_douban_id': external.get('douban_id')}
                sources = self._aggregate(detail=detail)
            candidates = [source for source in sources if source['from'] == code]
            source = next((s for s in candidates if s.get('row') == token.get('i') and s.get('subline') == token.get('n')), candidates[0] if len(candidates) == 1 else None)
        else:
            params = {'vod_id': identity, 'from': code}
            if token.get('r'):
                params['base_revision'] = token['r']
            data = self._request('vod/playback_v2', params, timeout=20)
            if not isinstance(data, dict):
                raise _ApiError('播放目录响应错误')
            revision = _text(data.get('revision'))
            if token.get('r') and revision and token['r'] != revision:
                raise _ApiError('播放目录版本已更新，请重新打开详情')
            source = next((self._source(row) for row in data.get('sources', []) if isinstance(row, dict) and _text(row.get('from')) == code), None)
        episode = source['episodes'].get(position) if source else None
        if not episode or not episode['url']:
            raise _ApiError('该线路的本集地址暂不可用')
        return episode['url'], source['decode_status']

    def _media_type(self, value, headers):
        path = urlsplit(value).path.lower()
        if '.m3u8' in path or '/m3u8/' in path or path.endswith('/getm3u8'):
            return 'm3u8'
        if path.endswith('.mpd'):
            return 'mpd'
        if path.endswith(('.mp4', '.m4v', '.mov')):
            return 'mp4'
        if _MEDIA_RE.search(path):
            return ''
        try:
            request_headers = dict(headers)
            request_headers['Range'] = 'bytes=0-1023'
            with build_opener().open(Request(value, headers=request_headers), timeout=6) as response:
                content_type = response.headers.get('Content-Type', '').lower()
                prefix = response.read(1024).lstrip(b'\xef\xbb\xbf \r\n\t')
                if 'mpegurl' in content_type or prefix.startswith(b'#EXTM3U'):
                    return 'm3u8'
                if 'dash+xml' in content_type or b'<MPD' in prefix:
                    return 'mpd'
        except Exception:
            pass
        return ''

    def playerContent(self, flag, id, vipFlags=None):
        self._ready()
        try:
            identity = _text(id).strip()
            if identity.startswith('xjkp:'):
                token = _unpack('xjkp:', identity)
                value, status = self._episode_url(token)
                if status in ('1', '2'):
                    cache_key = ('decode', _text(token.get('s')), value)
                    resolved = self._get_cached(cache_key)
                    if resolved is None:
                        resolved = self._request('decode/url/', {'url': value, 'vodFrom': token.get('s'), '_t': int(time.time()*1000)}, timeout=15, success=1)
                        if not isinstance(resolved, str) or not _http_url(resolved.strip()):
                            raise _ApiError('解析接口未返回有效媒体地址')
                        resolved = resolved.strip()
                        self._put_cached(cache_key, resolved, 20)
                    value = resolved
            else:
                value = identity
            if not _http_url(value):
                raise _ApiError('未取得有效媒体地址')
            headers = {'User-Agent': _MOBILE_UA if urlsplit(value).path.lower().endswith('.mpd') else _UA}
            media_type = self._media_type(value, headers)
            if media_type == 'mpd':
                headers['User-Agent'] = _MOBILE_UA
            result = {'parse': 0, 'url': value, 'header': headers}
            if media_type:
                result['type'] = media_type
            return result
        except Exception as exc:
            return {'parse': 0, 'url': '', 'header': {}, 'msg': self._failure(exc)}

    def isVideoFormat(self, url):
        return bool(_MEDIA_RE.search(_text(url)))

    def manualVideoCheck(self):
        return False

    def localProxy(self, param):
        return [404, 'text/plain; charset=utf-8', '']

    def action(self, action):
        self._ready()
        if action == 'last_error':
            return self._last_error
        return ''

    def destroy(self):
        if hasattr(self, '_cache'):
            with self._lock:
                self._cache.clear()
        return None




import hmac
from html.parser import HTMLParser
from urllib.parse import quote, unquote, urljoin




def _gmul(a, b):
    value = 0
    for _ in range(8):
        if b & 1:
            value ^= a
        a = (a << 1) ^ (0x11b if a & 128 else 0)
        b >>= 1
    return value & 255


def _sbox_value(value):
    inverse, base, exponent = 1, value, 254
    while exponent:
        if exponent & 1:
            inverse = _gmul(inverse, base)
        base = _gmul(base, base)
        exponent >>= 1
    if value == 0:
        inverse = 0
    result = inverse ^ 0x63
    for shift in (1, 2, 3, 4):
        result ^= ((inverse << shift) | (inverse >> (8-shift))) & 255
    return result


_SBOX = tuple(_sbox_value(n) for n in range(256))
_INV_SBOX = tuple(_SBOX.index(n) for n in range(256))


class _AES:
    def __init__(self, key):
        if len(key) not in (16, 24, 32):
            raise ValueError('Invalid AES key size')
        self.rounds = len(key) // 4 + 6
        words = [list(key[i:i+4]) for i in range(0, len(key), 4)]
        nk, rcon = len(words), 1
        for index in range(nk, 4*(self.rounds+1)):
            word = words[-1][:]
            if index % nk == 0:
                word = [_SBOX[x] for x in word[1:] + word[:1]]
                word[0] ^= rcon
                rcon = _gmul(rcon, 2)
            elif nk > 6 and index % nk == 4:
                word = [_SBOX[x] for x in word]
            words.append([a ^ b for a, b in zip(words[index-nk], word)])
        self.keys = [sum(words[i:i+4], []) for i in range(0, len(words), 4)]

    def encrypt(self, block):
        if len(block) != 16:
            raise ValueError('Invalid AES block')
        state = [a ^ b for a, b in zip(block, self.keys[0])]
        for number in range(1, self.rounds+1):
            state = [_SBOX[state[((c+r) % 4)*4+r]] for c in range(4) for r in range(4)]
            if number < self.rounds:
                for start in range(0, 16, 4):
                    a, b, c, d = state[start:start+4]
                    state[start:start+4] = [_gmul(a, 2)^_gmul(b, 3)^c^d, a^_gmul(b, 2)^_gmul(c, 3)^d, a^b^_gmul(c, 2)^_gmul(d, 3), _gmul(a, 3)^b^c^_gmul(d, 2)]
            state = [a ^ b for a, b in zip(state, self.keys[number])]
        return bytes(state)

    def decrypt(self, block):
        if len(block) != 16:
            raise ValueError('Invalid AES block')
        state = [a ^ b for a, b in zip(block, self.keys[-1])]
        for number in range(self.rounds-1, -1, -1):
            state = [_INV_SBOX[state[((c-r) % 4)*4+r]] for c in range(4) for r in range(4)]
            state = [a ^ b for a, b in zip(state, self.keys[number])]
            if number:
                for start in range(0, 16, 4):
                    a, b, c, d = state[start:start+4]
                    state[start:start+4] = [_gmul(a, 14)^_gmul(b, 11)^_gmul(c, 13)^_gmul(d, 9), _gmul(a, 9)^_gmul(b, 14)^_gmul(c, 11)^_gmul(d, 13), _gmul(a, 13)^_gmul(b, 9)^_gmul(c, 14)^_gmul(d, 11), _gmul(a, 11)^_gmul(b, 13)^_gmul(c, 9)^_gmul(d, 14)]
        return bytes(state)


def _unpad(data):
    if not data or data[-1] < 1 or data[-1] > 16 or data[-data[-1]:] != bytes([data[-1]]) * data[-1]:
        raise ValueError('Invalid AES padding')
    return data[:-data[-1]]


def _cbc_decrypt(key, iv, ciphertext):
    if len(iv) != 16 or not ciphertext or len(ciphertext) % 16:
        raise ValueError('Invalid CBC ciphertext')
    aes, output = _AES(key), bytearray()
    for start in range(0, len(ciphertext), 16):
        block = ciphertext[start:start+16]
        output.extend(a ^ b for a, b in zip(aes.decrypt(block), iv))
        iv = block
    return _unpad(bytes(output))


def _gcm_multiply(x, y):
    z = 0
    for i in range(128):
        if x & (1 << (127-i)):
            z ^= y
        y = (y >> 1) ^ (0xe1000000000000000000000000000000 if y & 1 else 0)
    return z


def _gcm_decrypt(key, nonce, ciphertext, tag, aad=b''):
    if len(nonce) != 12 or len(tag) != 16:
        raise ValueError('Invalid GCM parameters')
    aes = _AES(key)
    h = int.from_bytes(aes.encrypt(bytes(16)), 'big')
    accumulator = 0
    for data in (aad, ciphertext):
        for start in range(0, len(data), 16):
            block = data[start:start+16].ljust(16, b'\0')
            accumulator = _gcm_multiply(accumulator ^ int.from_bytes(block, 'big'), h)
    lengths = (len(aad)*8).to_bytes(8, 'big') + (len(ciphertext)*8).to_bytes(8, 'big')
    accumulator = _gcm_multiply(accumulator ^ int.from_bytes(lengths, 'big'), h)
    j0 = nonce + b'\0\0\0\1'
    expected = bytes(a ^ b for a, b in zip(aes.encrypt(j0), accumulator.to_bytes(16, 'big')))
    if not hmac.compare_digest(expected, tag):
        raise ValueError('Invalid GCM authentication tag')
    output = bytearray()
    for index, start in enumerate(range(0, len(ciphertext), 16), 2):
        stream = aes.encrypt(nonce + index.to_bytes(4, 'big'))
        output.extend(a ^ b for a, b in zip(ciphertext[start:start+16], stream))
    return bytes(output)




_ED_Q = 2**255 - 19
_ED_L = 2**252 + 27742317777372353535851937790883648493
_ED_D = -121665 * pow(121666, _ED_Q-2, _ED_Q) % _ED_Q
_ED_I = pow(2, (_ED_Q-1)//4, _ED_Q)
_ED_ZERO = (0, 1, 1, 0)


def _ed_add(p, q):
    a = (p[1]-p[0])*(q[1]-q[0]) % _ED_Q
    b = (p[1]+p[0])*(q[1]+q[0]) % _ED_Q
    c = 2*_ED_D*p[3]*q[3] % _ED_Q
    d = 2*p[2]*q[2] % _ED_Q
    e, f, g, h = b-a, d-c, d+c, b+a
    return e*f % _ED_Q, g*h % _ED_Q, f*g % _ED_Q, e*h % _ED_Q


def _ed_mul(p, scalar):
    result = _ED_ZERO
    while scalar:
        if scalar & 1:
            result = _ed_add(result, p)
        p = _ed_add(p, p)
        scalar >>= 1
    return result


def _ed_equal(p, q):
    return (p[0]*q[2]-q[0]*p[2]) % _ED_Q == 0 and (p[1]*q[2]-q[1]*p[2]) % _ED_Q == 0


def _ed_decode(raw):
    if len(raw) != 32:
        raise ValueError('Invalid Ed25519 point')
    value = int.from_bytes(raw, 'little')
    sign, y = value >> 255, value & (2**255-1)
    if y >= _ED_Q:
        raise ValueError('Noncanonical Ed25519 point')
    yy = y*y % _ED_Q
    xx = (yy-1)*pow(_ED_D*yy+1, _ED_Q-2, _ED_Q) % _ED_Q
    x = pow(xx, (_ED_Q+3)//8, _ED_Q)
    if x*x % _ED_Q != xx:
        x = x*_ED_I % _ED_Q
    if x*x % _ED_Q != xx or (x == 0 and sign):
        raise ValueError('Invalid Ed25519 point')
    if x & 1 != sign:
        x = _ED_Q-x
    return x, y, 1, x*y % _ED_Q


def _ed_verify(key, signature, message):
    if len(key) != 32 or len(signature) != 64:
        raise ValueError('Invalid Ed25519 signature')
    scalar = int.from_bytes(signature[32:], 'little')
    if scalar >= _ED_L:
        raise ValueError('Noncanonical Ed25519 signature')
    a, r = _ed_decode(key), _ed_decode(signature[:32])
    for point in (a, r):
        if _ed_equal(_ed_mul(point, 8), _ED_ZERO) or not _ed_equal(_ed_mul(point, _ED_L), _ED_ZERO):
            raise ValueError('Invalid Ed25519 subgroup')
    challenge = int.from_bytes(hashlib.sha512(signature[:32]+key+message).digest(), 'little') % _ED_L
    base = _ed_decode(bytes.fromhex('5866666666666666666666666666666666666666666666666666666666666666'))
    if not _ed_equal(_ed_mul(base, scalar), _ed_add(r, _ed_mul(a, challenge))):
        raise ValueError('Ed25519 signature mismatch')


class _DocumentText(HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.parts, self.hidden = [], []

    def handle_starttag(self, tag, attrs):
        if tag in ('script', 'style', 'template'):
            self.hidden.append(tag)
        elif not self.hidden and tag in ('p', 'div', 'pre', 'li', 'br'):
            self.parts.append('\n')

    def handle_endtag(self, tag):
        if self.hidden and tag == self.hidden[-1]:
            self.hidden.pop()
        elif not self.hidden and tag in ('p', 'div', 'pre', 'li'):
            self.parts.append('\n')

    def handle_data(self, text):
        if not self.hidden:
            self.parts.append(text)


def _b64url(value):
    if not isinstance(value, str) or not re.fullmatch(r'[A-Za-z0-9_-]+', value) or len(value)%4 == 1:
        raise ValueError('Invalid Base64url')
    raw = base64.urlsafe_b64decode(value + '='*(-len(value)%4))
    if base64.urlsafe_b64encode(raw).decode().rstrip('=') != value:
        raise ValueError('Noncanonical Base64url')
    return raw


def _endpoint_config(document):
    if len(document.encode('utf-8')) > 524288:
        raise ValueError('Endpoint document too large')
    parser = _DocumentText()
    parser.feed(document)
    text = ''.join(parser.parts)
    blocks = set(re.sub(r'\s', '', part) for part in re.findall(r'TVAPP_CONFIG_V1_BEGIN([\s\S]*?)TVAPP_CONFIG_V1_END', text))
    if len(blocks) != 1:
        raise ValueError('Endpoint configuration missing')
    raw = _b64url(blocks.pop())
    if len(raw) <= 95 or len(raw) > 65631 or raw[:3] != b'\x01\x01\x01':
        raise ValueError('Unsupported endpoint configuration')
    key = base64.b64decode('3EoMYcMw9X1igBsCb7CLCTKGTqWv9OpAAJr2xGa3co0=')
    aad = b'TVAPP_ENDPOINT_CONFIG_V1:TVAPP:production:A256GCM\0'+raw[:3]
    plain = _gcm_decrypt(key, raw[3:15], raw[15:-16], raw[-16:], aad)
    signature, payload = plain[:64], plain[64:]
    verify_key = base64.b64decode('Wouud32PFUGkngHhcYTwGNF55YE64oWBfoGeYmFpgmA=')
    _ed_verify(verify_key, signature, b'TVAPP_ENDPOINT_CONFIG_V1:TVAPP:production:signature\0'+payload)
    data = json.loads(payload)
    if data.get('v') != 1 or set(data)-set('vraose') or type(data.get('r')) is not int or data['r'] < 1:
        raise ValueError('Invalid endpoint payload')
    apis = data.get('a')
    if not isinstance(apis, list) or not 1 <= len(apis) <= 8:
        raise ValueError('Invalid API list')
    for url in apis:
        if not isinstance(url, str) or len(url) > 2048:
            raise ValueError('Invalid API endpoint')
        parsed = urlsplit(url)
        if parsed.scheme not in ('http', 'https') or not parsed.hostname or parsed.username or parsed.password or parsed.fragment or parsed.query:
            raise ValueError('Invalid API endpoint')
    return {'revision': data['r'], 'apis': [url.rstrip('/') for url in apis]}


def _decode_catalog(envelope):
    if isinstance(envelope, dict) and envelope.get('schema_version') == 1 and isinstance(envelope.get('sites'), list) and type(envelope.get('revision')) is int:
        return envelope
    if not isinstance(envelope, dict) or envelope.get('format') != 'gzip-aesgcm-v1':
        raise ValueError('Unsupported rule catalog')
    if type(envelope.get('revision')) is not int or not 0 <= envelope['revision'] <= 2**53-1:
        raise ValueError('Invalid catalog revision')
    digest = envelope.get('sha256', '')
    if not re.fullmatch(r'[a-f0-9]{64}', digest):
        raise ValueError('Invalid catalog digest')
    nonce = base64.b64decode(envelope['nonce'], validate=True)
    payload = base64.b64decode(envelope['payload'], validate=True)
    if len(nonce) != 12 or not 16 < len(payload) <= 8454144:
        raise ValueError('Invalid rule envelope')
    key = hashlib.sha256(b'TVAPP_RULE_CATALOG_V1\0'+_APP.encode()+b'\0'+_CLIENT_MATERIAL.encode()).digest()
    aad = json.dumps([envelope['format'], envelope['revision'], digest], separators=(',', ':')).encode()
    compressed = _gcm_decrypt(key, nonce, payload[:-16], payload[-16:], aad)
    inflater = zlib.decompressobj(31)
    raw = inflater.decompress(compressed, 8388609)
    if len(raw) > 8388608 or inflater.unconsumed_tail or not inflater.eof or inflater.unused_data:
        raise ValueError('Invalid compressed catalog')
    if not hmac.compare_digest(hashlib.sha256(raw).hexdigest(), digest):
        raise ValueError('Catalog digest mismatch')
    result = json.loads(raw)
    if result.get('revision') != envelope['revision'] or not isinstance(result.get('sites'), list):
        raise ValueError('Invalid decoded rule catalog')
    return result


class _WebClient:
    def __init__(self):
        self.opener = build_opener(HTTPCookieProcessor(CookieJar()))

    def text(self, url, data=None, headers=None, limit=4194304, timeout=10):
        if not _http_url(url):
            raise ValueError('Invalid source URL')
        request_headers = {'User-Agent': _UA, 'Accept-Encoding': 'gzip'}
        request_headers.update(headers or {})
        body = None
        if data is not None:
            if isinstance(data, dict):
                body = json.dumps(data, ensure_ascii=False, separators=(',', ':')).encode('utf-8')
                request_headers.setdefault('Content-Type', 'application/json')
            else:
                body = data.encode('utf-8') if isinstance(data, str) else data
        request = Request(url, data=body, headers=request_headers)
        try:
            response = self.opener.open(request, timeout=timeout)
        except HTTPError as exc:
            raise _ApiError('备用源 HTTP %d' % exc.code, status=exc.code)
        with response:
            raw = response.read(limit+1)
            if len(raw) > limit:
                raise ValueError('Source response too large')
            if response.headers.get('Content-Encoding','').lower() == 'gzip':
                inflater = zlib.decompressobj(31)
                raw = inflater.decompress(raw, limit+1)
                if len(raw) > limit or inflater.unconsumed_tail or not inflater.eof:
                    raise ValueError('Source compressed response too large')
            charset = response.headers.get_content_charset() or 'utf-8'
        try:
            return raw.decode(charset)
        except (UnicodeError, LookupError):
            return raw.decode('utf-8','replace')

    def get_json(self, url, params=None, headers=None, timeout=10):
        if params:
            url += ('&' if '?' in url else '?') + urlencode(params)
        return json.loads(self.text(url, headers=headers, timeout=timeout))

    def post_json(self, url, data, headers=None, timeout=10):
        return json.loads(self.text(url, data=data, headers=headers, timeout=timeout))


class _HtmlNode:
    def __init__(self, tag='', attrs=None, parent=None):
        self.tag, self.attrs, self.parent = tag, dict(attrs or []), parent
        self.children, self.parts = [], []

    def text(self):
        return ''.join(part.text() if isinstance(part, _HtmlNode) else part for part in self.parts)

    def all(self, tag=None):
        for child in self.children:
            if tag is None or child.tag == tag:
                yield child
            yield from child.all(tag)

    def classes(self):
        return set(self.attrs.get('class', '').split())


class _HtmlTree(HTMLParser):
    def __init__(self, document):
        super().__init__(convert_charrefs=True)
        self.root = _HtmlNode()
        self.current = self.root
        self.feed(document)

    def handle_starttag(self, tag, attrs):
        node = _HtmlNode(tag, attrs, self.current)
        self.current.children.append(node)
        self.current.parts.append(node)
        if tag not in ('area', 'base', 'br', 'col', 'embed', 'hr', 'img', 'input', 'link', 'meta', 'param', 'source', 'track', 'wbr'):
            self.current = node

    def handle_endtag(self, tag):
        node = self.current
        while node.parent is not None:
            if node.tag == tag:
                self.current = node.parent
                return
            node = node.parent

    def handle_startendtag(self, tag, attrs):
        self.handle_starttag(tag, attrs)
        self.handle_endtag(tag)

    def handle_data(self, data):
        self.current.parts.append(data)


def _title_key(value):
    return re.sub(r'[\s\u3000]+', '', html.unescape(_text(value))).casefold()


def _website_sources(site, detail):
    rule = site.get('rule') or {}
    name, year = _text(detail.get('vod_name')), _text(detail.get('vod_year'))
    base = site.get('base_url', '')
    client = _WebClient()
    if 'bttwo.' in base:
        query = base.replace('{name}', quote(name, safe=''))
        document = client.text(query)
        tree = _HtmlTree(document).root
        candidates = []
        for node in tree.all('div'):
            if not {'group', 'relative'} <= node.classes():
                continue
            image = next(node.all('img'), None)
            anchor = next(node.all('a'), None)
            if image is None or anchor is None or _title_key(image.attrs.get('alt')) != _title_key(name):
                continue
            text = node.text()
            candidates.append((0 if year and year in text else 1, urljoin(query, anchor.attrs.get('href', ''))))
        if not candidates:
            return []
        detail_url = sorted(candidates)[0][1]
        document = client.text(detail_url)
        tree = _HtmlTree(document).root
        managers = [node for node in tree.all() if 'episodeManager(' in node.attrs.get('x-data', '')]
        if not managers:
            raise ValueError('备用蓝光-A 详情结构已改变')
        manager = managers[0]
        line_names = re.findall(r"lineName\s*:\s*['\"]([^'\"]+)['\"]", manager.attrs['x-data'])
        lines = []
        for offset, line in enumerate(site.get('lines', []), 1):
            original = _text(line.get('original_name'))
            if original not in line_names:
                continue
            line_number = str(line_names.index(original)+1)
            episodes = []
            for anchor in manager.all('a'):
                if anchor.attrs.get('data-line') != line_number or not anchor.attrs.get('data-episode'):
                    continue
                href = anchor.attrs.get('href', '')
                if href:
                    episodes.append({'position': len(episodes)+1, 'title': anchor.attrs['data-episode'], 'url': urljoin(detail_url, href)})
            if episodes:
                lines.append({'source': site['site_key']+'_'+line['key'], 'name': line['name'], 'sort': line['sort'], 'episodes': episodes, 'managed': {'kind': 'website', 'site': 'bttwo', 'base': detail_url}})
        return lines
    if 'wdbay.' in base:
        document = client.text(base, data='searchword='+quote(name,safe=''), headers={'Content-Type':'application/x-www-form-urlencoded'})
        tree = _HtmlTree(document).root
        links = []
        for anchor in tree.all('a'):
            href = anchor.attrs.get('href', '')
            if '/view/' in href and _title_key(anchor.attrs.get('title') or anchor.text()) == _title_key(name):
                links.append(urljoin(base,href))
        if not links:
            return []
        detail_url = links[0]
        document = client.text(detail_url)
        tree = _HtmlTree(document).root
        nav = [node for node in tree.all('ul') if {'nav','nav-tabs'} <= node.classes()]
        tab_titles = []
        for node in nav:
            tab_titles.extend(anchor.text().strip() for anchor in node.all('a'))
        selections = site.get('lines', [])
        output = []
        for line in selections:
