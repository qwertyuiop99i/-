def _text(value):
    if value is None:
        return ''
    if isinstance(value, (list, tuple)):
        return ','.join(_text(x) for x in value if x is not None)
    if isinstance(value, dict):
        return ''
    return str(value)


def _int(value, default=1):
    try:
        number = int(value)
        return number if number > 0 else default
    except (TypeError, ValueError, OverflowError):
        return default


def _pack(kind, value):
    raw = json.dumps(value, ensure_ascii=False, separators=(',', ':')).encode('utf-8')
    return kind + base64.urlsafe_b64encode(raw).decode('ascii').rstrip('=')


def _unpack(kind, value):
    if not isinstance(value, str) or not value.startswith(kind) or len(value) > 131072:
        raise ValueError('Invalid playback identifier')
    raw = value[len(kind):]
    result = json.loads(base64.urlsafe_b64decode(raw + '=' * (-len(raw) % 4)).decode('utf-8'))
    if not isinstance(result, dict):
        raise ValueError('Invalid playback identifier')
    return result


def _http_url(value):
    try:
        p = urlsplit(value)
        return p.scheme in ('http', 'https') and bool(p.hostname) and not p.username and not p.password
    except (ValueError, TypeError):
        return False


class _ApiError(Exception):
    def __init__(self, message, code=0, status=0):
        self.code = code
        self.status = status
        self.message = re.sub(r'https?://\S+', '[URL]', _text(message))[:200] or '请求失败'
        super().__init__(self.message)


