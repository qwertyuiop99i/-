    def _device_id(self):
        cache_key = 'xiaojikankan_device_v1'
        getter = getattr(self, 'getCache', None)
        setter = getattr(self, 'setCache', None)
        if callable(getter):
            try:
                value = getter(cache_key)
                if isinstance(value, str) and re.fullmatch(r'uuid-[0-9a-f-]{36}', value):
                    return value
            except Exception:
                pass
        filename = os.path.join(tempfile.gettempdir(), '.xiaojikankan-device-v1')
