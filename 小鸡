        document = client.text(current, headers=headers, timeout=12)
        constants = dict(re.findall(r'''const\s+(Url|Sign|From)\s*=\s*["']([^"']*)["']''', document))
        if {'Url', 'Sign', 'From'} <= set(constants) and "url: 'api.php'" in document:
            data = client.get_json(urljoin(current, 'api.php'), {'url': constants['Url'], 'sign': constants['Sign'], 't': constants['From']}, headers={'User-Agent': _UA, 'Referer': current}, timeout=12)
            if isinstance(data, dict) and data.get('code') == 200 and _http_url(data.get('url')):
