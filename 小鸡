def _dx_extract(value, depth=0):
    if depth > 8:
        return ''
    if isinstance(value,str):
        if _http_url(value.strip()):
            return value.strip()
        parsed = _dx_json(value)
        return _dx_extract(parsed,depth+1) if parsed != value else ''
    if isinstance(value,list):
        for item in value:
            found = _dx_extract(item,depth+1)
            if found:
                return found
    if isinstance(value,dict):
        for key in ('url','m3u8','play_url','playUrl','video_url','videoUrl','link','data','result','text'):
            found = _dx_extract(value.get(key),depth+1)
            if found:
                return found
    return ''


def _dx_play_headers(packet):
    headers = {'User-Agent':'dart'}
    for part in _text(packet.get('headers')).split(','):
        colon, equal = part.find(':'), part.find('=')
        cut = colon if colon >= 0 else equal
        if cut < 0:
            continue
        key, value = part[:cut].strip(), part[cut+1:].strip()
        if key.lower() in ('user-agent','referer'):
            headers['User-Agent' if key.lower()=='user-agent' else 'Referer'] = value
    return headers


