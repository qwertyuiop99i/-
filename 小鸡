class Spider(_CoreSpider):
    def init(self, extend=''):
        result = super().init(extend)
        if isinstance(extend, str):
            try:
                extend = json.loads(extend) if extend.strip().startswith('{') else {}
            except ValueError:
                extend = {}
        config = extend if isinstance(extend, dict) else {}
        self._managed = config.get('managed', True) is not False
        self._apis = [self._api]
        if not config.get('api'):
            self._apis.append('https://179.255.99.4:8090')
        self._endpoint_revision = 2
        self._endpoints_checked = 0
        self._rule_issues = []
        return result

    def _refresh_endpoints(self):
        now = time.monotonic()
        if now < self._endpoints_checked:
            return
        self._endpoints_checked = now+3600
        locations = ['https://anotepad.com/notes/wcqhmtf9', 'https://res.cloudinary.com/wygbngdd/raw/upload/1.txt', 'https://gitee.com/ahashare/sharetv/raw/master/README.md']
        for location in locations:
            try:
                document = _WebClient().text(location, headers={'User-Agent': _UA}, limit=524288, timeout=6)
                decoded = _endpoint_config(document)
                if decoded['revision'] < self._endpoint_revision:
                    continue
                self._endpoint_revision = decoded['revision']
                self._apis = decoded['apis']
                return
            except Exception:
                continue

    def _request(self, path, params=None, ttl=0, timeout=15, success=200):
        self._ready()
        try:
            return super()._request(path, params, ttl, timeout, success)
        except _ApiError as exc:
            if exc.status or not exc.message.startswith('网络请求失败'):
                raise
            previous = self._api
            alternatives = [api for api in self._apis if api != previous]
            for api in alternatives[:1]:
                self._api = api
                try:
                    return super()._request(path, params, ttl, timeout, success)
                except _ApiError as error:
                    if error.status or not error.message.startswith('网络请求失败'):
                        raise
                    exc = error
            self._api = previous
            self._refresh_endpoints()
            raise exc

    def _rule_catalog(self):
        cached = self._get_cached(('managed_catalog',))
        if cached is not None:
            return cached
        encrypted = self._request('rule-sources', ttl=300, timeout=15)
        catalog = _decode_catalog(encrypted)
        return self._put_cached(('managed_catalog',), catalog, 300)

    def _managed_sources(self, detail):
        sources, issues = [], []
        catalog = self._rule_catalog()
        for site in catalog.get('sites', []):
            if not isinstance(site, dict):
                continue
            try:
                rows = _managed_site_sources(site, detail)
                for row in rows:
                    episodes = row.get('episodes', [])
                    source = self._source({'from': row['source'], 'display_name': row['name'], 'sort': row['sort'], 'decode_status': '0', 'episodes': episodes})
                    if source and episodes:
                        source['managed'] = row.get('managed')
                        source['play_headers'] = row.get('headers') or {}
                        sources.append(source)
            except Exception as exc:
                issues.append({'source': _text(site.get('name')), 'error': self._failure(exc)})
        self._rule_issues = issues
        return sources

    def _playlists(self, sources, identity, revision):
        names, groups = super()._playlists(sources, identity, revision)
        if not names:
            return names, groups
        sorted_sources = [source for source in sorted(sources, key=lambda row: row['sort']) if source['episodes'] or source['episode_count']]
        encoded_groups = groups.split('$$$')
        for index, source in enumerate(sorted_sources):
            if not source.get('managed'):
                continue
            updated = []
            for entry in encoded_groups[index].split('#'):
                title, _, encoded = entry.partition('$')
                token = _unpack('xjkp:', encoded)
                token['m'] = source['managed']
                if source.get('play_headers'):
                    token['h'] = source['play_headers']
                updated.append(title+'$'+_pack('xjkp:', token))
            encoded_groups[index] = '#'.join(updated)
        return names, '$$$'.join(encoded_groups)

    def detailContent(self, ids):
        self._ready()
        identity = _text(ids[0] if isinstance(ids, (list, tuple)) and ids else ids).strip()
        try:
            if identity.startswith('xjkx:'):
                detail = _unpack('xjkx:', identity)
                sources = self._aggregate(detail=detail)
                revision = ''
            else:
                if not identity:
                    raise _ApiError('影片标识为空')
                detail, state = self._native_catalog(identity)
                revision = state['revision']
                sources = list(state['sources'].values())
                if self._include_external:
                    try:
                        sources.extend(self._aggregate(identity))
                    except _ApiError as exc:
                        self._failure(exc)
            if self._managed:
                try:
                    sources.extend(self._managed_sources(detail))
                except Exception as exc:
                    self._rule_issues = [{'source': '托管备用源', 'error': self._failure(exc)}]
            item = self._item(detail, identity.startswith('xjkx:')) or {}
            item['vod_id'] = identity
            for key in ('vod_actor', 'vod_director', 'vod_class', 'vod_area', 'vod_year', 'type_name'):
                item[key] = _text(detail.get(key))
            item['vod_content'] = html.unescape(re.sub(r'<[^>]*>', '', _text(detail.get('vod_content'))))
            item['vod_play_from'], item['vod_play_url'] = self._playlists(sources, identity, revision)
            return {'list': [item]}
        except Exception as exc:
            return {'list': [], 'msg': self._failure(exc)}

    def playerContent(self, flag, id, vipFlags=None):
        self._ready()
        identity = _text(id)
        if not identity.startswith('xjkp:'):
            return super().playerContent(flag, id, vipFlags)
        try:
            token = _unpack('xjkp:', identity)
            managed = token.get('m')
            if not isinstance(managed, dict):
                return super().playerContent(flag, id, vipFlags)
            value = token.get('u')
            resolved = _managed_resolve(managed, value)
            if not isinstance(resolved, dict) or not _http_url(resolved.get('url')):
                raise _ApiError('备用源未取得有效媒体地址')
            headers = resolved.get('headers') or token.get('h') or {'User-Agent': _UA}
            headers = {key: _text(value) for key, value in headers.items() if key.lower() in ('user-agent', 'referer', 'origin', 'cookie') and '\r' not in _text(value) and '\n' not in _text(value)}
            headers.setdefault('User-Agent', _UA)
            kind = self._media_type(resolved['url'], headers)
            result = {'parse': resolved.get('parse', 0), 'url': resolved['url'], 'header': headers}
            if kind:
                result['type'] = kind
            return result
        except Exception as exc:
            return {'parse': 0, 'url': '', 'header': {}, 'msg': self._failure(exc)}

    def action(self, value):
        if value == 'source_status':
            self._ready()
            return json.dumps(self._rule_issues, ensure_ascii=False)
        return super().action(value)



