        return {'parse':0,'url':token,'headers':headers}
    result = _dx_request('secret_parse_api_url',{'token':'','url':token,'player_code':_text(packet.get('code'))},config)
    resolved = _dx_extract(result)
    if resolved and resolved != token:
        return {'parse':0,'url':resolved,'headers':headers}
    used = set()
    for parser in (packet.get('parse_api'),packet.get('extra_parse_api')):
        if not parser or parser in used:
            continue
        used.add(parser)
        for suffix in (token,quote(token,safe='')):
            target = parser+suffix if 'url=' in parser else parser+('&url=' if '?' in parser else '?url=')+suffix
            if not _http_url(target):
                continue
            try:
                response = _WebClient().text(target,headers={'User-Agent':_text(config.get('user_agent'))},timeout=12)
                resolved = _dx_extract(response)
                if not resolved:
                    resolved = _dx_extract(_dx_crypto('parse_decrypt',response,config))
                if resolved:
