            raise ValueError('奇优解析接口未返回媒体地址')
        match = re.search(r'\bplayer_[A-Za-z0-9_]+\s*=\s*', document)
        if match:
            try:
                player = json.JSONDecoder().raw_decode(document[match.end():].lstrip())[0]
                value = _text(player.get('url'))
                if str(player.get('encrypt')) == '1':
                    value = unquote(value)
                elif str(player.get('encrypt')) == '2':
                    value = unquote(base64.b64decode(value).decode('utf-8'))
                if _http_url(value) and _MEDIA_RE.search(urlsplit(value).path):
                    return {'parse':0, 'url':value, 'headers':headers}
            except (ValueError, UnicodeError):
                pass
        tree = _HtmlTree(document).root
        media = next((node.attrs.get('src') for node in tree.all() if node.tag in ('video','source') and node.attrs.get('src')), '')
        if media:
            return {'parse':0,'url':urljoin(current,media),'headers':headers}
        iframe = next((node.attrs.get('src') for node in tree.all('iframe') if node.attrs.get('src')), '')
        if iframe:
            current=urljoin(current,iframe)
            continue
        patterns = [r'''\b(?:url|videoUrl|playUrl)\s*[:=]\s*["'](https?[^"']+)["']''', r'''["'](https?[^"'\s<>]+\.m3u8(?:\?[^"'\s<>]*)?)["']''']
        for pattern in patterns:
            for found in re.findall(pattern, document):
                value = html.unescape(found.replace('\\/','/'))
                if _http_url(value) and _MEDIA_RE.search(value):
                    return {'parse':0,'url':value,'headers':headers}
        break
    return {'parse':1,'url':url,'headers':headers}


