    def _get_cached(self, key):
        with self._lock:
            entry = self._cache.get(key)
            if entry and entry[0] > time.monotonic():
                self._cache.move_to_end(key)
                return entry[1]
            self._cache.pop(key, None)
        return None

    def _put_cached(self, key, value, ttl):
        if ttl <= 0:
            return value
        with self._lock:
            self._cache[key] = (time.monotonic() + ttl, value)
            self._cache.move_to_end(key)
            while len(self._cache) > 96:
                self._cache.popitem(last=False)
        return value

    def _request(self, path, params=None, ttl=0, timeout=15, success=200):
        self._ready()
        params = {k: _text(v) for k, v in (params or {}).items() if v is not None and _text(v) != ''}
        key = ('api', path, tuple(sorted(params.items())))
        cached = self._get_cached(key) if ttl else None
        if cached is not None:
            return cached
        url = self._api + '/api.php/app/' + path.lstrip('/')
        if params:
            url += '?' + urlencode(params)
        request = Request(url, headers=self._headers())
        try:
            try:
                response = self._opener.open(request, timeout=timeout)
            except HTTPError as exc:
                response = exc
            with response:
                status = response.code
                raw = response.read(8388609)
                if len(raw) > 8388608:
                    raise _ApiError('接口响应过大', status=status)
                if response.headers.get('Content-Encoding', '').lower() == 'gzip':
                    inflater = zlib.decompressobj(31)
                    raw = inflater.decompress(raw, 16777217)
                    if inflater.unconsumed_tail or not inflater.eof:
                        raise _ApiError('接口压缩响应错误或过大', status=status)
                if len(raw) > 16777216:
                    raise _ApiError('接口响应过大', status=status)
                try:
                    result = json.loads(raw.decode('utf-8-sig'))
                except (ValueError, UnicodeError):
                    raise _ApiError('接口未返回有效 JSON', status=status)
            if not isinstance(result, dict):
                raise _ApiError('接口数据结构错误', status=status)
            code = result.get('code')
            if status != 200 or code != success:
                raise _ApiError(result.get('msg'), code=code, status=status)
            return self._put_cached(key, result.get('data'), ttl)
        except _ApiError:
            raise
        except Exception as exc:
            raise _ApiError('网络请求失败 (%s)' % type(exc).__name__)

    def _failure(self, exc):
        self._last_error = exc.message if isinstance(exc, _ApiError) else '数据处理失败 (%s)' % type(exc).__name__
        return self._last_error

